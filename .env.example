# Copy to .env.local and fill in. Never commit real values.
# Only server code reads these, except variables prefixed NEXT_PUBLIC_.

# ── APP ───────────────────────────────────────────────────────────────
# Public base URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── DATABASE ──────────────────────────────────────────────────────────
# Any PostgreSQL 14+ (local, Neon, Supabase Postgres, RDS, ...).
DATABASE_URL=postgres://user@localhost:5432/saqinadev_dev
# Separate database for integration tests. Tests refuse to run unless the name contains "_test".
DATABASE_URL_TEST=postgres://user@localhost:5432/saqinadev_test

# ── AUTH (Better Auth) ────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -base64 32`. Rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Origin the app is served from; must match the OAuth redirect URI host.
BETTER_AUTH_URL=http://localhost:3000
# Extra browser origins Better Auth should trust, comma separated. The base URL and its
# www / non-www twin are trusted automatically. Prefer redirecting one host to the other.
BETTER_AUTH_TRUSTED_ORIGINS=
# Google OAuth. Leave empty to hide "Continue with Google".
# Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Connect with GitHub" on the import form (optional). Create an OAuth App under GitHub
# Settings > Developer settings; its callback URL is {BETTER_AUTH_URL}/api/github/callback.
# Without both values the form keeps its manual token field.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── EMAIL ─────────────────────────────────────────────────────────────
# Verification and password-reset email via Resend. Without both values, emails are printed
# to the server console (development only).
RESEND_API_KEY=
EMAIL_FROM="Saqina Dev <no-reply@example.com>"

# ── SECRETS & PLATFORM ────────────────────────────────────────────────
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts provider keys, Git tokens,
# MCP and agent secrets in the database. Losing it makes stored credentials unreadable.
SAQINA_ENCRYPTION_KEY=
# Comma-separated emails that act as platform owner until an owner exists in the database.
PLATFORM_OWNER_EMAILS=
# Default owner account, created by `pnpm db:create-owner` (idempotent). Only that script reads
# these: do not add OWNER_PASSWORD to the hosting dashboard. Leave the password empty to have
# a strong one generated and printed once. OWNER_EMAIL falls back to PLATFORM_OWNER_EMAILS.
# For Neon, export its direct (non-pooler) URL for that one command:
#   DATABASE_URL='postgres://...' pnpm db:create-owner
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=
# Development only: allow localhost endpoints (custom AI providers, MCP, webhooks) and a
# local repository path as a Git connection. Ignored in production.
ALLOW_LOCAL_ENDPOINTS=
ALLOW_LOCAL_GIT=

# ── AI (optional) ─────────────────────────────────────────────────────
# Providers and models are configured by the platform owner in Dashboard → AI & Models.
# This env key is only the system fallback when no configured model fits a request.
# Without a key, Saqina answers from deterministic project rules and no data leaves the server.
# With a key, read-only answers and intent detection use Claude; actions stay rule-validated.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ── FUTURE (not read by Phase 4 code) ─────────────────────────────────
# VERCEL:  Vercel integration token for project provisioning.
# SUPABASE: only if the database moves to Supabase-specific features.

# ── REMINDERS (Phase 6) ───────────────────────────────────────────────
# Shared secret for GET /api/cron/reminders (Vercel Cron sends it as a Bearer token).
# Generate with: openssl rand -base64 32. Without it the endpoint refuses every call.
CRON_SECRET=

# ── CAPTCHA (Cloudflare Turnstile, production only) ───────────────────
# Guards sign-in, sign-up, password reset, verification resend and the service inquiry form.
# It switches itself off outside production builds, so leave both empty locally.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile and add the site's
# domain. Both values are needed: with only one of them captcha stays off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
