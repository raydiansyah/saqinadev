# /opt/saqina/.env on the VPS (chmod 600). Names only: values never go into git.
# Compose reads it for the app containers and for ${…} in compose.yaml.
# NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_TURNSTILE_SITE_KEY are not here: they are fixed into the image at
# build time from the repository's variables (image.yml).

# Image and domain
SAQINA_TAG=
SAQINA_DOMAIN=

# Database. Today: Neon's pooled connection string. After the move: postgres://saqina:…@postgres:5432/saqina
DATABASE_URL=
# Only with the localdb profile
POSTGRES_PASSWORD=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
PLATFORM_OWNER_EMAILS=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Encryption of stored keys and tokens
SAQINA_ENCRYPTION_KEY=

# AI (optional; the Owner can also add providers in the app)
ANTHROPIC_API_KEY=
AI_MODEL=

# Scheduler and cron routes
CRON_SECRET=

# Captcha (server half)
TURNSTILE_SECRET_KEY=

# Chat attachments (S3 or R2)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Publishing client projects
VERCEL_TOKEN=
VERCEL_TEAM_ID=
SAQINA_PROJECTS_DOMAIN=

# Backups (deploy/backup.sh): R2 bucket and a direct (not pooled) database URL to dump
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=
BACKUP_R2_KEY=
BACKUP_R2_SECRET=
BACKUP_DATABASE_URL=
