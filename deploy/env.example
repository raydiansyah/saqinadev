# /opt/saqina/.env on the VPS (chmod 600). Names only: values never go into git.
# Compose reads it for the app containers and for ${…} in compose.yaml.
# NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_TURNSTILE_SITE_KEY are not here: they are fixed into the image at
# build time from the repository's variables (image.yml).

# Image and domain. deploy.sh writes SAQINA_TAG after each deploy; do not set it by hand.
SAQINA_TAG=
SAQINA_DOMAIN=

# Database. Today: Neon's pooled connection string. After the move: postgres://saqina:…@postgres:5432/saqina
DATABASE_URL=
# Migrations (deploy.sh): Neon's direct URL (no -pooler). Empty: DATABASE_URL is used.
MIGRATE_DATABASE_URL=
# Only with the localdb profile
POSTGRES_PASSWORD=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PLATFORM_OWNER_EMAILS=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Scheduler and cron routes
CRON_SECRET=

# Captcha (server half)
TURNSTILE_SECRET_KEY=

# Backups (deploy/backup.sh): R2 bucket and a direct (not pooled) database URL to dump
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=
BACKUP_R2_KEY=
BACKUP_R2_SECRET=
BACKUP_DATABASE_URL=
