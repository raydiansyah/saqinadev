{
  "name": "saqinadev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:coverage": "tsx scripts/check-coverage.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:migrate:neon": "bash scripts/neon-migrate.sh",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "db:create-owner": "tsx --conditions=react-server --env-file=.env.local scripts/create-owner.ts",
    "db:studio": "drizzle-kit studio",
    "smoke": "tsx scripts/smoke.ts",
    "email:preview": "tsx scripts/email-preview.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.33.0"
}
